@model Loan.Domain.Applications.LoanApplication

@{
    ViewData["Title"] = $"Review Application {Model.ApplicationId}";
    var rec = Model.CurrentRecommendation;
    var ind = Model.Indicators;
    var isClosed = Model.Status == Loan.Domain.Applications.ApplicationStatus.Approved ||
                   Model.Status == Loan.Domain.Applications.ApplicationStatus.Rejected;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Application Review: @Model.ApplicationId</h1>
        <p class="page-subtitle">Applicant: <strong>@Model.Facts.FullName</strong> (Synthetic ID: <code>@Model.Facts.SyntheticId</code>)</p>
    </div>
    <div>
        <span class="badge @(Model.Status == Loan.Domain.Applications.ApplicationStatus.Approved ? "badge-success" : Model.Status == Loan.Domain.Applications.ApplicationStatus.Rejected ? "badge-danger" : "badge-warning")">
            Status: @Model.Status
        </span>
    </div>
</div>

<!-- SSE Live Specialist Agent Multi-Agent Streaming Panel -->
<div id="agentStreamPanel" class="card" style="margin-bottom: 1.5rem; border: 1px solid var(--color-primary-border); background: var(--color-primary-bg); display: none;">
    <div class="card-header">
        <h2 class="card-title" style="font-size: 1rem;">⚡ Live Specialist Multi-Agent Execution</h2>
        <span id="agentStreamBadge" class="badge badge-info">Executing...</span>
    </div>
    <div id="agentStreamLog" style="font-family: var(--font-mono, monospace); font-size: 0.85rem; padding: 0.75rem; background: rgba(0,0,0,0.05); border-radius: 4px; max-height: 150px; overflow-y: auto; color: var(--text-color);">
        Connecting to agent stream...
    </div>
</div>

<!-- Side-by-Side Review Split Grid (Flow C) -->
<div class="review-grid">
    <!-- Left Column: Verified Facts & Verification Tools Outputs -->
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">🔍 Facts & Verification Evidence</h2>
            <span class="badge badge-info">Tool Provenance</span>
        </div>

        <table class="table" style="margin-bottom: 1.5rem;">
            <tbody>
                <tr>
                    <td><strong>Monthly Gross Income:</strong></td>
                    <td>@Model.Facts.MonthlyGrossIncome</td>
                    <td>
                        @if (Model.Facts.IsIncomeVerified)
                        {
                            <span class="badge badge-success">Verified Tool ✓</span>
                        }
                        else
                        {
                            <span class="badge badge-warning">Unverified</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td><strong>Monthly Debts:</strong></td>
                    <td>@Model.Facts.MonthlyDebts</td>
                    <td><span class="badge badge-info">Declared</span></td>
                </tr>
                <tr>
                    <td><strong>Requested Loan Amount:</strong></td>
                    <td>@Model.Facts.RequestedLoanAmount</td>
                    <td><span class="badge badge-info">Stated</span></td>
                </tr>
                <tr>
                    <td><strong>Estimated Property Value:</strong></td>
                    <td>@Model.Facts.EstimatedPropertyValue</td>
                    <td><span class="badge badge-info">Appraisal</span></td>
                </tr>
                <tr>
                    <td><strong>Credit Score:</strong></td>
                    <td>@Model.Facts.CreditScore</td>
                    <td>
                        @if (Model.Facts.IsCreditVerified)
                        {
                            <span class="badge badge-success">Verified Bureau ✓</span>
                        }
                        else
                        {
                            <span class="badge badge-warning">Stated</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td><strong>Identity Verification:</strong></td>
                    <td colspan="2">
                        @if (Model.Facts.IsIdentityVerified)
                        {
                            <span class="badge badge-success">Identity Verified ✓</span>
                        }
                        else
                        {
                            <span class="badge badge-danger">Unverified Identity</span>
                        }
                    </td>
                </tr>
            </tbody>
        </table>

        <!-- Calculated Ratios (BR-03) -->
        <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.75rem;">Calculated Deterministic Ratios:</h3>
        @if (ind != null)
        {
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                <div style="background: var(--bg-main); padding: 1rem; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                    <div style="font-size: 0.8rem; color: var(--text-muted);">Debt-to-Income (DTI)</div>
                    <div style="font-size: 1.5rem; font-weight: 700; color: @(ind.IsDtiEligible ? "var(--color-success)" : "var(--color-danger)");">
                        @(ind.DebtToIncomeRatio.HasValue ? ind.DebtToIncomeRatio.Value.ToString("P1") : "N/A")
                    </div>
                    <div style="font-size: 0.75rem; color: var(--text-muted);">Max Threshold: @Model.ProductRules.MaxDtiRatio.ToString("P1")</div>
                </div>

                <div style="background: var(--bg-main); padding: 1rem; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                    <div style="font-size: 0.8rem; color: var(--text-muted);">Loan-to-Value (LTV)</div>
                    <div style="font-size: 1.5rem; font-weight: 700; color: @(ind.IsLtvEligible ? "var(--color-success)" : "var(--color-danger)");">
                        @(ind.LoanToValueRatio.HasValue ? ind.LoanToValueRatio.Value.ToString("P1") : "N/A")
                    </div>
                    <div style="font-size: 0.75rem; color: var(--text-muted);">Max Threshold: @Model.ProductRules.MaxLtvRatio.ToString("P1")</div>
                </div>
            </div>
        }

        <!-- Ingested Evidence Documents & AI Extracted Facts (GPT-4o) -->
        <div style="border-top: 1px solid var(--border-color); padding-top: 1.25rem; margin-bottom: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin: 0;">📂 Ingested Evidence & AI-Extracted Facts</h3>
                <span class="badge badge-info">@Model.Documents.Count Documents</span>
            </div>

            @if (!Model.Documents.Any())
            {
                <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0;">No evidence documents uploaded yet.</p>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                    @foreach (var doc in Model.Documents)
                    {
                        var avgDocConf = doc.Fields.Any() ? doc.Fields.Average(f => f.ConfidenceScore) : 1.0f;
                        var isDocHigh = avgDocConf >= 0.85f;
                        <div style="background: var(--bg-main); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 0.75rem;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                                <div>
                                    <strong style="font-size: 0.85rem;">@doc.FileName</strong>
                                    <span class="badge badge-info" style="font-size: 0.7rem; margin-left: 0.35rem;">@doc.DocumentType</span>
                                </div>
                                <span class="badge @(isDocHigh ? "badge-success" : "badge-warning")" style="font-size: 0.7rem;">
                                    Confidence: @( (int)(avgDocConf * 100) )%
                                </span>
                            </div>

                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.4rem;">
                                @foreach (var field in doc.Fields)
                                {
                                    var isFieldLow = field.ConfidenceScore < 0.85f;
                                    <div style="background: white; border: 1px solid @(isFieldLow ? "#fde68a" : "#e2e8f0"); border-radius: 4px; padding: 0.3rem 0.5rem; font-size: 0.75rem;">
                                        <div style="display: flex; justify-content: space-between;">
                                            <span style="color: var(--text-muted);">@field.FieldName</span>
                                            <span style="font-weight: 700; color: @(isFieldLow ? "#b45309" : "#047857");">@( (int)(field.ConfidenceScore * 100) )%</span>
                                        </div>
                                        <div style="font-weight: 700; color: var(--text-color); font-family: monospace; margin-top: 0.15rem;">
                                            @(field.IsSensitive ? field.RawValueMasked : field.DisplayValue)
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(field.ProvenanceExcerpt))
                                        {
                                            <div style="font-size: 0.65rem; color: #64748b; font-style: italic; margin-top: 0.15rem;">
                                                @field.ProvenanceExcerpt
                                            </div>
                                        }
                                        <div style="margin-top: 0.2rem; font-size: 0.65rem;">
                                            @if (field.NeedsConfirmation)
                                            {
                                                <span style="color: #b45309; font-weight: 700;">⚠️ Needs Confirmation</span>
                                            }
                                            else
                                            {
                                                <span style="color: #047857; font-weight: 600;">✓ Confirmed Fact</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Immutable Audit Trail Timeline -->
        <div style="border-top: 1px solid var(--border-color); padding-top: 1.25rem;">
            <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.75rem;">📜 Immutable Audit Trail</h3>
            <div style="max-height: 250px; overflow-y: auto;">
                <table class="table" style="font-size: 0.8rem;">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Actor</th>
                            <th>Timestamp (UTC)</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (rec != null && rec.AuditTrail.Any())
                        {
                            foreach (var audit in rec.AuditTrail)
                            {
                                <tr>
                                    <td><span class="badge badge-info">@audit.Action</span></td>
                                    <td><code>@audit.PerformedBy</code></td>
                                    <td>@audit.TimestampUtc.ToString("u")</td>
                                    <td>@audit.Notes</td>
                                </tr>
                            }
                        }
                        @if (Model.DocumentAuditTrail.Any())
                        {
                            foreach (var docAudit in Model.DocumentAuditTrail)
                            {
                                <tr>
                                    <td><span class="badge badge-warning">@docAudit.Action (@docAudit.FieldName)</span></td>
                                    <td><code>@docAudit.ActorId</code> (@docAudit.ActorRole)</td>
                                    <td>@docAudit.TimestampUtc.ToString("u")</td>
                                    <td>@docAudit.Reason</td>
                                </tr>
                            }
                        }
                        @if ((rec == null || !rec.AuditTrail.Any()) && !Model.DocumentAuditTrail.Any())
                        {
                            <tr>
                                <td colspan="4" style="color: var(--text-muted); text-align: center;">No audit log events recorded yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Right Column: System Recommendation Draft, Citations, Policy Violations, & Officer Action -->
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">🤖 Specialist Agent Recommendation Draft</h2>
            @if (rec != null)
            {
                <span class="badge @(rec.DecisionRecommendation == RecommendationType.Approve ? "badge-success" : rec.DecisionRecommendation == RecommendationType.PendingInformation ? "badge-warning" : "badge-danger")">
                    Draft: @rec.DecisionRecommendation
                </span>
            }
        </div>

        @if (rec != null)
        {
            <!-- Non-Approval Guarantee Disclaimer -->
            <div style="background: var(--color-warning-bg, #fffbeb); border: 1px solid var(--color-warning-border, #fef3c7); padding: 0.75rem 1rem; border-radius: var(--radius-sm, 4px); margin-bottom: 1.25rem; font-size: 0.8rem; color: #92400e;">
                <strong>🛡️ AI Safety Guardrail:</strong> @Loan.Application.Agents.RecommendationOrchestratorAgent.NonApprovalDisclaimer
            </div>

            <div style="margin-bottom: 1.5rem;">
                <h3 style="font-size: 0.9rem; font-weight: 700; color: var(--text-muted);">Summary Reasoning:</h3>
                <p style="font-size: 0.95rem; line-height: 1.6; margin-top: 0.25rem;">@rec.SummaryReasoning</p>
            </div>

            @if (rec.MissingEvidenceItems.Any())
            {
                <div class="card" style="background: var(--color-warning-bg); border: 1px solid var(--color-warning-border); padding: 1rem; margin-bottom: 1rem;">
                    <h4 style="font-size: 0.85rem; font-weight: 700; color: var(--color-warning); margin-bottom: 0.35rem;">⚠️ Missing Evidence Items (BR-06):</h4>
                    <ul style="padding-left: 1.25rem; font-size: 0.85rem; color: #92400e;">
                        @foreach (var item in rec.MissingEvidenceItems)
                        {
                            <li>@item</li>
                        }
                    </ul>
                </div>
            }

            @if (rec.PolicyViolations.Any())
            {
                <div class="card" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); padding: 1rem; margin-bottom: 1rem;">
                    <h4 style="font-size: 0.85rem; font-weight: 700; color: var(--color-danger); margin-bottom: 0.35rem;">🛑 Policy Exceptions & Violations:</h4>
                    <ul style="padding-left: 1.25rem; font-size: 0.85rem; color: var(--color-danger);">
                        @foreach (var item in rec.PolicyViolations)
                        {
                            <li>@item</li>
                        }
                    </ul>
                </div>
            }

            @if (rec.Citations.Any())
            {
                <div class="citation-box" style="margin-bottom: 1.5rem;">
                    <div class="citation-header">
                        <span>📜 Effective Policy Citation (@rec.Citations.First().PolicyVersion)</span>
                    </div>
                    <p class="citation-excerpt">"@rec.Citations.First().Excerpt"</p>
                    <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">
                        Source: @rec.Citations.First().DocumentTitle — @rec.Citations.First().SectionOrPage
                    </p>
                </div>
            }
        }

        <!-- Officer Decision Action Form (BR-07) -->
        <div style="border-top: 1px solid var(--border-color); padding-top: 1.25rem; margin-bottom: 1.5rem;">
            <h3 style="font-size: 1rem; font-weight: 700; color: var(--color-secondary); margin-bottom: 0.75rem;">⚖️ Authorized Officer Decision (BR-07)</h3>

            @if (isClosed)
            {
                <div style="padding: 1rem; background: var(--bg-main); border: 1px solid var(--border-color); border-radius: var(--radius-md);">
                    <p style="margin: 0; font-weight: 600; color: var(--text-muted);">
                        This application is closed with status: <span class="badge @(Model.Status == Loan.Domain.Applications.ApplicationStatus.Approved ? "badge-success" : "badge-danger")">@Model.Status</span>
                    </p>
                    @if (rec?.ApprovedByOfficerId != null)
                    {
                        <p style="font-size: 0.85rem; margin-top: 0.5rem; color: var(--text-muted);">
                            Decision by Officer <code>@rec.ApprovedByOfficerId</code> on @rec.ApprovedAtUtc?.ToString("g") UTC
                        </p>
                        <p style="font-size: 0.85rem; font-style: italic; color: var(--text-color);">
                            Notes: "@rec.OfficerDecisionNotes"
                        </p>
                    }
                </div>
            }
            else
            {
                <form asp-action="SubmitDecision" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.ApplicationId" />

                    <div class="form-group" style="margin-bottom: 0.75rem;">
                        <label class="form-label" for="officerIdInput">Officer ID / Employee Badge:</label>
                        <input type="text" id="officerIdInput" name="officerId" class="form-control" value="@(User.Identity?.Name ?? "OFFICER-42")" required />
                    </div>

                    <div class="form-group" style="margin-bottom: 1rem;">
                        <label class="form-label" for="notesInput">Officer Decision Notes & Justification (Mandatory):</label>
                        <textarea id="notesInput" name="notes" class="form-control" rows="3" placeholder="Enter decision notes, exception rationale, or info requested..." required></textarea>
                    </div>

                    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                        <button type="submit" name="action" value="@RecommendationStatus.ApprovedByOfficer" class="btn btn-success">Approve Application</button>
                        <button type="submit" name="action" value="@RecommendationStatus.ReturnedForInfo" class="btn btn-secondary">Request Information</button>
                        <button type="submit" name="action" value="@RecommendationStatus.RejectedByOfficer" class="btn btn-danger">Reject Application</button>
                    </div>
                </form>
            }
        </div>

        <!-- Officer Underwriting AI Assistant (Flow C) -->
        <div style="border-top: 1px solid var(--border-color); padding-top: 1.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <h3 style="font-size: 1rem; font-weight: 700; color: #1e3a8a; margin: 0;">🤖 Underwriting AI Copilot</h3>
                <span class="badge" style="background: #ecfdf5; color: #065f46; font-size: 0.72rem;">Grounded Azure RAG</span>
            </div>
            
            <div id="officerChatHistory" style="min-height: 120px; max-height: 220px; overflow-y: auto; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 0.75rem; margin-bottom: 0.75rem; font-size: 0.85rem;">
                <span style="color: #64748b;">Ask underwriting or exception policy questions for @Model.ProductRules.ProductName (e.g. "What exceptions permit DTI over 43%?" or "What are the TRID timing requirements?"):</span>
            </div>

            <div style="display: flex; gap: 0.5rem;">
                <input type="text" id="officerQInput" class="form-control" placeholder="Ask policy question..." style="font-size: 0.85rem; padding: 0.5rem 0.75rem; flex: 1;" onkeydown="if(event.key==='Enter'){event.preventDefault(); sendOfficerQuestion();}" />
                <button type="button" id="btnOfficerSend" class="btn btn-primary" style="font-size: 0.85rem; padding: 0.5rem 1rem;" onclick="sendOfficerQuestion()">Query</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Optional SSE trigger if agent stream button or auto-stream is enabled
            var appId = '@Model.ApplicationId';
            var streamPanel = document.getElementById('agentStreamPanel');
            var streamLog = document.getElementById('agentStreamLog');
            var streamBadge = document.getElementById('agentStreamBadge');

            if (window.location.search.includes('stream=true')) {
                streamPanel.style.display = 'block';
                var eventSource = new EventSource('/Officer/StreamRecommendationDraft?id=' + appId);

                eventSource.addEventListener('DocumentAgent', function (e) {
                    streamLog.innerHTML += '<div>[DocAgent] ' + e.data + '</div>';
                });
                eventSource.addEventListener('EligibilityAgent', function (e) {
                    streamLog.innerHTML += '<div>[EligAgent] ' + e.data + '</div>';
                });
                eventSource.addEventListener('ComplianceAgent', function (e) {
                    streamLog.innerHTML += '<div>[CompAgent] ' + e.data + '</div>';
                });
                eventSource.addEventListener('Orchestrator', function (e) {
                    streamLog.innerHTML += '<div>[Orchestrator] ' + e.data + '</div>';
                });
                eventSource.addEventListener('Complete', function (e) {
                    streamLog.innerHTML += '<div style="color: var(--color-success); font-weight: bold;">[Complete] Recommendation Draft saved! Reloading view...</div>';
                    streamBadge.innerText = 'Completed';
                    streamBadge.className = 'badge badge-success';
                    eventSource.close();
                    setTimeout(function() { window.location.href = '/Officer/Review/' + appId; }, 1000);
                });
                eventSource.onerror = function (e) {
                    streamLog.innerHTML += '<div style="color: var(--color-danger);">[Error] Stream closed.</div>';
                    eventSource.close();
                };
            }
        });

        async function sendOfficerQuestion() {
            const input = document.getElementById('officerQInput');
            const question = input.value.trim();
            if (!question) return;

            const chatHistory = document.getElementById('officerChatHistory');
            const btnSend = document.getElementById('btnOfficerSend');

            const userMsg = document.createElement('div');
            userMsg.style.margin = '0.5rem 0';
            userMsg.innerHTML = `<strong style="color:#0f172a;">Officer:</strong> ${question}`;
            chatHistory.appendChild(userMsg);
            input.value = '';
            btnSend.disabled = true;

            const aiMsg = document.createElement('div');
            aiMsg.style.margin = '0.5rem 0';
            aiMsg.style.color = '#1e3a8a';
            const aiText = document.createElement('span');
            aiMsg.innerHTML = `<strong style="color:#2563eb;">Copilot:</strong> `;
            aiMsg.appendChild(aiText);
            chatHistory.appendChild(aiMsg);
            chatHistory.scrollTop = chatHistory.scrollHeight;

            try {
                const encodedQ = encodeURIComponent(question);
                const response = await fetch(`/Officer/OfficerChatStream?question=${encodedQ}&applicationId=@Model.ApplicationId`);
                const reader = response.body.getReader();
                const decoder = new TextDecoder();
                let buffer = '';

                while (true) {
                    const { done, value } = await reader.read();
                    if (done) break;

                    buffer += decoder.decode(value, { stream: true });
                    const lines = buffer.split('\n');
                    buffer = lines.pop();

                    for (const line of lines) {
                        if (line.startsWith('data: ')) {
                            const dataStr = line.replace('data: ', '').trim();
                            if (dataStr === '[DONE]') break;

                            try {
                                const parsed = JSON.parse(dataStr);
                                if (parsed.chunk) {
                                    aiText.innerText += parsed.chunk;
                                    chatHistory.scrollTop = chatHistory.scrollHeight;
                                }
                                if (parsed.isFinal && parsed.citations && parsed.citations.length > 0) {
                                    const citeEl = document.createElement('div');
                                    citeEl.style.fontSize = '0.75rem';
                                    citeEl.style.color = '#475569';
                                    citeEl.style.marginTop = '0.5rem';
                                    citeEl.style.paddingTop = '0.35rem';
                                    citeEl.style.borderTop = '1px solid #f1f5f9';

                                    let citeHtml = '<strong style="display: block; margin-bottom: 0.25rem; color: #1e3a8a;">📚 Grounded Policy Sources:</strong>';
                                    parsed.citations.forEach((c, idx) => {
                                        citeHtml += `<span style="display: inline-block; background: #f8fafc; border: 1px solid #cbd5e1; padding: 0.15rem 0.45rem; border-radius: 4px; margin-right: 0.35rem; margin-bottom: 0.25rem;">[${idx + 1}] ${c.title || c.documentTitle || 'Policy'} (Sec. ${c.section || 'N/A'})</span>`;
                                    });
                                    citeEl.innerHTML = citeHtml;
                                    aiMsg.appendChild(citeEl);
                                }
                            } catch (e) {}
                        }
                    }
                }
            } catch (err) {
                aiText.innerText += ' [Network error]';
            } finally {
                btnSend.disabled = false;
            }
        }
    </script>
}

