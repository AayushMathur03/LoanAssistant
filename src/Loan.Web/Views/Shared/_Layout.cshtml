<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Loan Application & Compliance Review Assistant</title>
    <link rel="stylesheet" href="~/css/fintech-theme.css" />
</head>
<body>
    <div class="app-container">
        <!-- Top Navbar Header -->
        <header class="navbar">
            <a href="/" class="navbar-brand">
                <div class="brand-icon">LA</div>
                <span>Apex Lending AI</span>
            </a>

            <nav>
                <ul class="navbar-nav">
                    <li><a href="/Applicant" class="nav-link @(ViewData["ActiveNav"]?.ToString() == "Applicant" ? "active" : "")">Applicant Portal</a></li>
                    <li><a href="/Officer" class="nav-link @(ViewData["ActiveNav"]?.ToString() == "Officer" ? "active" : "")">Officer Review</a></li>
                    <li><a href="/Compliance" class="nav-link @(ViewData["ActiveNav"]?.ToString() == "Compliance" ? "active" : "")">Compliance Audit</a></li>
                    <li><a href="/Admin" class="nav-link @(ViewData["ActiveNav"]?.ToString() == "Admin" ? "active" : "")">System Admin</a></li>
                </ul>
            </nav>

            <!-- Active Persona Switcher -->
            <div class="persona-switcher">
                <button class="persona-btn @(ViewData["ActiveNav"]?.ToString() == "Applicant" ? "active" : "")" data-persona="applicant">Applicant</button>
                <button class="persona-btn @(ViewData["ActiveNav"]?.ToString() == "Officer" ? "active" : "")" data-persona="officer">Loan Officer</button>
                <button class="persona-btn @(ViewData["ActiveNav"]?.ToString() == "Compliance" ? "active" : "")" data-persona="compliance">Compliance</button>
                <button class="persona-btn @(ViewData["ActiveNav"]?.ToString() == "Admin" ? "active" : "")" data-persona="admin">Admin</button>
            </div>
        </header>

        <!-- Main Page Content -->
        <main role="main" class="main-content">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="footer">
            <p><strong>Apex Lending Assistant v1.2</strong> — CapGemini AI Launchpad Capstone | Privacy-Aware Human-in-the-Loop Loan Processing System</p>
            <p style="font-size: 0.75rem; margin-top: 0.25rem; color: #64748b;">
                Disclaimer: AI models never issue binding loan decisions. All final eligibility approvals require authorized loan officer sign-off per BR-01 & BR-07.
            </p>
        </footer>
    </div>

    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
