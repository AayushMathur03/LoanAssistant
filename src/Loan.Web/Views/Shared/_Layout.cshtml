<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Loan Application & Compliance Review Assistant</title>
    <link rel="stylesheet" href="~/css/fintech-theme.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true"></script>
</head>
<body>
    <div class="app-container">
        <!-- Top Navbar Header -->
        <header class="navbar">
            <a href="/" class="navbar-brand">
                <div class="brand-icon">LA</div>
                <span>Apex Lending AI</span>
            </a>

            <nav>
                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Applicant") || User.IsInRole("Administrator"))
                        {
                            <li><a href="/Applicant" class="nav-link @(ViewData["ActiveNav"]?.ToString() == "Applicant" ? "active" : "")">Applicant Portal</a></li>
                        }
                        @if (User.IsInRole("LoanOfficer") || User.IsInRole("Administrator"))
                        {
                            <li><a href="/Officer" class="nav-link @(ViewData["ActiveNav"]?.ToString() == "Officer" ? "active" : "")">Officer Review</a></li>
                        }
                        @if (User.IsInRole("ComplianceReviewer") || User.IsInRole("Administrator"))
                        {
                            <li><a href="/Compliance" class="nav-link @(ViewData["ActiveNav"]?.ToString() == "Compliance" ? "active" : "")">Compliance Audit</a></li>
                        }
                        @if (User.IsInRole("Administrator"))
                        {
                            <li><a href="/Admin" class="nav-link @(ViewData["ActiveNav"]?.ToString() == "Admin" ? "active" : "")">System Admin</a></li>
                        }
                    }
                    else
                    {
                        <li><a href="/" class="nav-link">Home</a></li>
                    }
                </ul>
            </nav>

            <!-- Authentication / Persona Controls -->
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var userRole = User.IsInRole("Administrator") ? "Administrator" :
                                   User.IsInRole("LoanOfficer") ? "LoanOfficer" :
                                   User.IsInRole("ComplianceReviewer") ? "Compliance" : "Applicant";

                    var badgeColor = userRole switch
                    {
                        "Administrator" => "background: #ede9fe; color: #5b21b6; border: 1px solid #c4b5fd;",
                        "LoanOfficer" => "background: #d1fae5; color: #065f46; border: 1px solid #a7f3d0;",
                        "Compliance" => "background: #fef3c7; color: #92400e; border: 1px solid #fde68a;",
                        _ => "background: #e0e7ff; color: #3730a3; border: 1px solid #c7d2fe;"
                    };

                    <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem;">
                        <span style="font-weight: 600; color: #1e293b;">@User.Identity.Name</span>
                        <span style="@badgeColor font-size: 0.72rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 9999px;">
                            @userRole
                        </span>
                    </div>

                    <a href="/Account/Login" class="btn" style="font-size: 0.8rem; padding: 0.35rem 0.65rem; border: 1px solid #cbd5e1; border-radius: 6px; color: #475569; text-decoration: none; background: #f8fafc;">
                        Switch Role
                    </a>

                    <form asp-controller="Account" asp-action="Logout" method="post" style="display: inline; margin: 0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn" style="font-size: 0.8rem; padding: 0.35rem 0.65rem; border: 1px solid #fca5a5; border-radius: 6px; color: #b91c1c; background: #fff1f2; cursor: pointer; font-weight: 500;">
                            Sign Out
                        </button>
                    </form>
                }
                else
                {
                    <a href="/Account/Login" class="btn btn-primary" style="font-size: 0.85rem; padding: 0.4rem 0.9rem; background: #2563eb; color: white; text-decoration: none; border-radius: 6px; font-weight: 600;">
                        Sign In
                    </a>
                }
            </div>
        </header>

        <!-- Main Page Content -->
        <main role="main" class="main-content">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="footer">
            <p><strong>Apex Lending Assistant v1.2</strong> — CapGemini AI Launchpad Capstone | Privacy-Aware Human-in-the-Loop Loan Processing System</p>
            <p style="font-size: 0.75rem; margin-top: 0.25rem; color: #64748b;">
                Disclaimer: AI models never issue binding loan decisions. All final eligibility approvals require authorized loan officer sign-off per BR-01 & BR-07.
            </p>
        </footer>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
