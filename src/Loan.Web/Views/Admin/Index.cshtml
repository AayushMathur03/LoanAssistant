@model Loan.Web.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "System Admin & AI Governance";
    ViewData["ActiveNav"] = "Admin";
}

<div style="max-width: 1200px; margin: 0 auto; padding: 1.5rem 1rem;">
    <!-- Page Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
        <div>
            <span style="font-size: 0.75rem; font-weight: 700; color: #7c3aed; text-transform: uppercase; letter-spacing: 0.05em; background: #ede9fe; padding: 0.25rem 0.65rem; border-radius: 9999px;">
                Platform & AI Governance
            </span>
            <h1 style="font-size: 1.85rem; font-weight: 800; color: #0f172a; margin: 0.4rem 0 0.2rem 0;">Administrator Workspace</h1>
            <p style="font-size: 0.95rem; color: #64748b; margin: 0;">
                Live observability, telemetry metrics, Azure resource health, RAG policy index metadata, and MCP tool registry.
            </p>
        </div>
        <div>
            <span class="badge" style="background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; font-size: 0.82rem; font-weight: 700; padding: 0.45rem 0.85rem; border-radius: 8px;">
                ⚙️ Governance Role (No Underwriting Authority)
            </span>
        </div>
    </div>

    <!-- System Health Grid (5 Services) -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
        <!-- SQL Server -->
        <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <span style="font-size: 0.78rem; font-weight: 700; color: #64748b;">SQL DATABASE</span>
                <span style="background: #ecfdf5; color: #065f46; font-size: 0.7rem; font-weight: 700; padding: 0.15rem 0.45rem; border-radius: 9999px;">Online</span>
            </div>
            <div style="font-size: 1.15rem; font-weight: 700; color: #0f172a;">@Model.Health.SqlStatus</div>
            <span style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 0.25rem;">LoanAssistantDb &bull; EF Core</span>
        </div>

        <!-- Azure OpenAI -->
        <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <span style="font-size: 0.78rem; font-weight: 700; color: #64748b;">AZURE OPENAI</span>
                <span style="background: #ecfdf5; color: #065f46; font-size: 0.7rem; font-weight: 700; padding: 0.15rem 0.45rem; border-radius: 9999px;">Connected</span>
            </div>
            <div style="font-size: 1.15rem; font-weight: 700; color: #0f172a;">@Model.Health.OpenAiDeployment</div>
            <span style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 0.25rem;">Embedding: @Model.Health.EmbeddingDeployment</span>
        </div>

        <!-- Azure AI Search -->
        <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <span style="font-size: 0.78rem; font-weight: 700; color: #64748b;">AI SEARCH RAG</span>
                <span style="background: #ecfdf5; color: #065f46; font-size: 0.7rem; font-weight: 700; padding: 0.15rem 0.45rem; border-radius: 9999px;">Active</span>
            </div>
            <div style="font-size: 1.15rem; font-weight: 700; color: #0f172a;">@Model.Health.SearchIndex</div>
            <span style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 0.25rem;">Hybrid Vector + Semantic</span>
        </div>

        <!-- Azure Blob Storage -->
        <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <span style="font-size: 0.78rem; font-weight: 700; color: #64748b;">BLOB STORAGE</span>
                <span style="background: #ecfdf5; color: #065f46; font-size: 0.7rem; font-weight: 700; padding: 0.15rem 0.45rem; border-radius: 9999px;">Private</span>
            </div>
            <div style="font-size: 1.15rem; font-weight: 700; color: #0f172a;">@Model.Health.AzureBlobStatus</div>
            <span style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 0.25rem;">Private Container &bull; Hash Verification</span>
        </div>

        <!-- MCP Tool Server -->
        <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <span style="font-size: 0.78rem; font-weight: 700; color: #64748b;">MCP TOOL SERVER</span>
                <span style="background: #ecfdf5; color: #065f46; font-size: 0.7rem; font-weight: 700; padding: 0.15rem 0.45rem; border-radius: 9999px;">Ready</span>
            </div>
            <div style="font-size: 1.15rem; font-weight: 700; color: #0f172a;">@Model.McpTools.Count Tools</div>
            <span style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 0.25rem;">Streamable HTTP /api/mcp</span>
        </div>
    </div>

    <!-- Two Column Grid: RAG Metadata & Telemetry -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem;">
        <!-- RAG Policy Corpus Metadata -->
        <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <h2 style="font-size: 1.15rem; font-weight: 700; color: #1e293b; margin: 0;">📚 Authoritative Policy Index Metadata</h2>
                <span class="badge badge-info">8 Active Policy Documents</span>
            </div>

            <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.85rem;">
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 0.75rem;">
                    <div style="display: flex; justify-content: space-between; font-weight: 600; color: #0f172a;">
                        <span>Personal Loan Guide</span>
                        <span style="color: #2563eb;">@Model.RagMetadata.ActivePersonalLoanVersion</span>
                    </div>
                    <span style="font-size: 0.75rem; color: #64748b;">Max Loan: $75,000 &bull; Max DTI: 38.0% &bull; Min Credit: 600</span>
                </div>

                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 0.75rem;">
                    <div style="display: flex; justify-content: space-between; font-weight: 600; color: #0f172a;">
                        <span>Residential Mortgage Guide</span>
                        <span style="color: #2563eb;">@Model.RagMetadata.ActiveMortgageVersion</span>
                    </div>
                    <span style="font-size: 0.75rem; color: #64748b;">Max Loan: $750,000 &bull; Max LTV: 80.0% &bull; Max DTI: 43.0%</span>
                </div>

                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 0.75rem;">
                    <div style="display: flex; justify-content: space-between; font-weight: 600; color: #0f172a;">
                        <span>Consumer Protection & Disclosures</span>
                        <span style="color: #2563eb;">@Model.RagMetadata.ActiveComplianceVersion</span>
                    </div>
                    <span style="font-size: 0.75rem; color: #64748b;">Section 8.1 TRID/RESPA 3-Business-Day Loan Estimate Delivery Rule</span>
                </div>
            </div>

            <!-- One-Click Synchronize Seed Policies to Azure AI Search -->
            <form asp-action="SyncSeedPolicies" method="post" style="margin-top: 1.25rem; background: #eff6ff; border: 1.5px solid #bfdbfe; border-radius: 8px; padding: 1rem;">
                @Html.AntiForgeryToken()
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                    <strong style="font-size: 0.88rem; color: #1e3a8a;">🔄 Synchronize Authoritative Policies to Azure AI Search</strong>
                    <span style="font-size: 0.72rem; color: #2563eb; font-weight: 700; background: #dbeafe; padding: 0.15rem 0.5rem; border-radius: 9999px;">text-embedding-3-small</span>
                </div>
                <p style="font-size: 0.78rem; color: #475569; margin: 0 0 0.75rem 0; line-height: 1.4;">
                    Scans all 8 canonical underwriting guides in <code>Search/SeedPolicies/</code>, chunks policy sections, generates 1536-dimensional embeddings with Azure OpenAI, and updates index <code>loan-policies-index</code> with HNSW vector configurations.
                </p>
                <button type="submit" class="btn" style="width: 100%; background: #1e40af; color: white; border: none; padding: 0.55rem; border-radius: 6px; font-weight: 700; font-size: 0.84rem; cursor: pointer; display: flex; justify-content: center; align-items: center; gap: 0.5rem;">
                    <span>⚡ Run One-Click Policy Indexing & Synchronization Now</span>
                </button>
            </form>

            <!-- Dynamic Policy Upload & Vector Re-Indexing Form (Task 6) -->
            <form asp-action="UploadPolicyDocument" method="post" enctype="multipart/form-data" style="margin-top: 1rem; background: #f8fafc; border: 1.5px dashed #cbd5e1; border-radius: 8px; padding: 1rem;">
                @Html.AntiForgeryToken()
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                    <strong style="font-size: 0.85rem; color: #0f172a;">⚡ Ingest & Vectorize New Policy Document</strong>
                    <span style="font-size: 0.72rem; color: #64748b;">HNSW Vector Embeddings</span>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-bottom: 0.75rem;">
                    <div>
                        <label style="font-size: 0.72rem; color: #475569; display: block; font-weight: 600;">Policy Title</label>
                        <input type="text" name="customTitle" class="form-control" placeholder="e.g. Commercial Loan Policy" style="width: 100%; padding: 0.35rem 0.5rem; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.8rem;" />
                    </div>
                    <div>
                        <label style="font-size: 0.72rem; color: #475569; display: block; font-weight: 600;">Version Tag</label>
                        <input type="text" name="versionTag" class="form-control" placeholder="v2.1" value="v2.1" style="width: 100%; padding: 0.35rem 0.5rem; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.8rem;" />
                    </div>
                </div>
                <div style="margin-bottom: 0.75rem;">
                    <label style="font-size: 0.72rem; color: #475569; display: block; font-weight: 600;">Markdown Policy File (.md, .txt)</label>
                    <input type="file" name="policyFile" accept=".md,.txt" style="font-size: 0.78rem; width: 100%;" required />
                </div>
                <button type="submit" class="btn" style="width: 100%; background: #2563eb; color: white; border: none; padding: 0.45rem; border-radius: 6px; font-weight: 700; font-size: 0.82rem; cursor: pointer;">
                    Upload & Re-Index Policy
                </button>
            </form>
        </div>

        <!-- Structured Telemetry & Measured Token Tracking -->
        <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <h2 style="font-size: 1.15rem; font-weight: 700; color: #1e293b; margin: 0;">📊 Structured Telemetry & LLM Tokens</h2>
                <span class="badge badge-success">Telemetry Collector Active</span>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                <div style="background: #f8fafc; padding: 0.75rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                    <span style="font-size: 0.72rem; color: #64748b; text-transform: uppercase; display: block;">Total Token Usage</span>
                    <strong style="font-size: 1.4rem; color: #0f172a;">@Model.Telemetry.TotalTokens.ToString("N0")</strong>
                    <span style="font-size: 0.72rem; color: #64748b; display: block;">Prompt: @Model.Telemetry.PromptTokens.ToString("N0") &bull; Comp: @Model.Telemetry.CompletionTokens.ToString("N0")</span>
                </div>

                <div style="background: #f8fafc; padding: 0.75rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                    <span style="font-size: 0.72rem; color: #64748b; text-transform: uppercase; display: block;">Average LLM Latency</span>
                    <strong style="font-size: 1.4rem; color: #2563eb;">@Model.Telemetry.AverageLlmLatencyMs.ToString("F0") ms</strong>
                    <span style="font-size: 0.72rem; color: #64748b; display: block;">HTTP Latency: @Model.Telemetry.AverageHttpLatencyMs.ToString("F0") ms</span>
                </div>
            </div>

            <!-- Capstone 20-Prompt Evaluation Summary -->
            <div style="background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; padding: 0.75rem 1rem; font-size: 0.82rem; color: #065f46;">
                <div style="display: flex; justify-content: space-between; font-weight: 700; margin-bottom: 0.25rem;">
                    <span>Capstone Evaluation Benchmark:</span>
                    <span>100% Passed</span>
                </div>
                <div>Offline Deterministic: <strong>@Model.Evaluation.OfflineScore</strong> &bull; Live Azure AI: <strong>@Model.Evaluation.LiveAzureScore</strong></div>
            </div>
        </div>
    </div>

    <!-- Approved MCP Tools Registry Table -->
    <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h2 style="font-size: 1.15rem; font-weight: 700; color: #1e293b; margin: 0;">🔌 Approved MCP Tools Registry (FR-09)</h2>
            <span class="badge badge-success">5 Registered Tools</span>
        </div>

        <div style="overflow-x: auto;">
            <table class="table" style="width: 100%; border-collapse: collapse; font-size: 0.85rem;">
                <thead>
                    <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0; text-align: left;">
                        <th style="padding: 0.6rem 0.75rem;">Tool Name</th>
                        <th style="padding: 0.6rem 0.75rem;">Description</th>
                        <th style="padding: 0.6rem 0.75rem;">Authorized Roles & Scope</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tool in Model.McpTools)
                    {
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 0.6rem 0.75rem;"><code>@tool.Name</code></td>
                            <td style="padding: 0.6rem 0.75rem;">@tool.Description</td>
                            <td style="padding: 0.6rem 0.75rem;">
                                <span class="badge badge-info" style="font-size: 0.72rem;">@tool.AllowedRoles</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
