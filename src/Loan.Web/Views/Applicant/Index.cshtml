<!-- Modal 3: Confirm Extracted Field -->
<div id="confirmFieldModal" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);">
    <div style="background: white; max-width: 460px; margin: 8% auto; padding: 1.75rem; border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.2);">
        <h3 style="font-size: 1.15rem; font-weight: 700; color: #0f172a; margin: 0 0 0.5rem 0;">⚠️ Confirm Extracted Fact</h3>
        <p style="font-size: 0.85rem; color: #64748b; margin-bottom: 1.25rem;">
            Optical scan confidence was below 85%. Please confirm or correct the value to update effective underwriting facts:
        </p>

        <form asp-action="ConfirmField" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="modalConfirmAppId" name="applicationId" value="" />
            <input type="hidden" id="modalConfirmDocId" name="documentId" value="" />
            <input type="hidden" id="modalConfirmFieldName" name="fieldName" value="" />

            <div style="margin-bottom: 1rem;">
                <label id="lblFieldName" style="display: block; font-size: 0.82rem; font-weight: 600; color: #334155; margin-bottom: 0.35rem;">Field Value</label>
                <input type="text" id="txtConfirmedValue" name="confirmedValue" class="form-control" style="width: 100%; padding: 0.55rem; border: 1px solid #cbd5e1; border-radius: 6px; font-weight: 700;" required />
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; font-size: 0.82rem; font-weight: 600; color: #334155; margin-bottom: 0.35rem;">Confirmation Reason</label>
                <input type="text" name="reason" class="form-control" value="Verified from original statement by applicant" style="width: 100%; padding: 0.55rem; border: 1px solid #cbd5e1; border-radius: 6px;" required />
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.75rem;">
                <button type="button" class="btn" style="background: #e2e8f0; color: #334155; border: none; padding: 0.55rem 1rem; border-radius: 6px; font-weight: 600; cursor: pointer;" onclick="document.getElementById('confirmFieldModal').style.display='none'">
                    Cancel
                </button>
                <button type="submit" class="btn" style="background: #059669; color: white; border: none; padding: 0.55rem 1.25rem; border-radius: 6px; font-weight: 700; cursor: pointer;">
                    Confirm Fact
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openNewAppModal(productType) {
        document.getElementById('modalProductType').value = productType;
        if (productType === 'Mortgage') {
            document.getElementById('modalRequestedAmount').value = 350000;
            document.getElementById('modalPropertyValue').value = 500000;
            document.getElementById('modalLoanPurpose').value = 'Primary Residence Purchase';
        } else if (productType === 'PersonalLoan') {
            document.getElementById('modalRequestedAmount').value = 25000;
            document.getElementById('modalPropertyValue').value = 0;
            document.getElementById('modalLoanPurpose').value = 'Debt Consolidation';
        } else if (productType === 'AutoLoan') {
            document.getElementById('modalRequestedAmount').value = 35000;
            document.getElementById('modalPropertyValue').value = 40000;
            document.getElementById('modalLoanPurpose').value = 'New Vehicle Purchase';
        }
        document.getElementById('newAppModal').style.display = 'block';
    }

    function openCustomLoanModal(productType, amount, term) {
        if (productType) document.getElementById('customProductType').value = productType;
        if (amount) document.getElementById('customRequestedAmount').value = amount;
        document.getElementById('customLoanModal').style.display = 'block';
    }

    function openConfirmModal(appId, docId, fieldName, currentValue) {
        document.getElementById('modalConfirmAppId').value = appId;
        document.getElementById('modalConfirmDocId').value = docId;
        document.getElementById('modalConfirmFieldName').value = fieldName;
        document.getElementById('lblFieldName').innerText = 'Confirmed Value for ' + fieldName;
        document.getElementById('txtConfirmedValue').value = currentValue;
        document.getElementById('confirmFieldModal').style.display = 'block';
    }

    function quickAsk(text) {
        const input = document.getElementById('streamQuestionInput');
        input.value = text;
        sendStreamQuestion();
    }

    let copilotMsgCounter = 0;

    async function sendStreamQuestion() {
        const input = document.getElementById('streamQuestionInput');
        const question = input.value.trim();
        if (!question) return;

        const chatHistory = document.getElementById('chatHistory');
        const btn = document.getElementById('btnSendStream');

        const currentMsgId = ++copilotMsgCounter;

        // Append user bubble
        const userDiv = document.createElement('div');
        userDiv.className = 'copilot-bubble-wrapper-user';
        userDiv.innerHTML = `
            <span class="copilot-sender-label">You</span>
            <div class="copilot-bubble-user">
                ${escapeHtml(question)}
            </div>
        `;
        chatHistory.appendChild(userDiv);
        input.value = '';
        btn.disabled = true;

        // Create Assistant bubble with shimmering typing dots
        const assistantWrapper = document.createElement('div');
        assistantWrapper.className = 'copilot-bubble-wrapper-assistant';
        assistantWrapper.innerHTML = `
            <span class="copilot-sender-label" style="color: #2563eb;">Apex AI Assistant</span>
            <div class="copilot-bubble-assistant" id="msg-bubble-${currentMsgId}">
                <div class="copilot-typing-shimmer" id="shimmer-${currentMsgId}">
                    <span class="copilot-typing-dot"></span>
                    <span class="copilot-typing-dot"></span>
                    <span class="copilot-typing-dot"></span>
                    <span>Analyzing policy documents...</span>
                </div>
                <div class="copilot-content-text" id="text-${currentMsgId}" style="display: none;"></div>
            </div>
        `;
        chatHistory.appendChild(assistantWrapper);
        chatHistory.scrollTop = chatHistory.scrollHeight;

        const bubbleElem = document.getElementById(`msg-bubble-${currentMsgId}`);
        const shimmerElem = document.getElementById(`shimmer-${currentMsgId}`);
        const textElem = document.getElementById(`text-${currentMsgId}`);

        let fullRawText = '';
        let citations = [];
        let disclaimerText = '';
        let isFirstToken = true;

        try {
            const url = `/Applicant/ChatStream?question=${encodeURIComponent(question)}`;
            const response = await fetch(url);
            const reader = response.body.getReader();
            const decoder = new TextDecoder();

            while (true) {
                const { value, done } = await reader.read();
                if (done) break;

                const text = decoder.decode(value);
                const lines = text.split('\n');

                for (const line of lines) {
                    if (line.startsWith('data: ')) {
                        const jsonStr = line.replace('data: ', '').trim();
                        if (jsonStr === '[DONE]') continue;

                        try {
                            const data = JSON.parse(jsonStr);
                            if (data.chunk) {
                                if (isFirstToken) {
                                    if (shimmerElem) shimmerElem.style.display = 'none';
                                    if (textElem) textElem.style.display = 'block';
                                    isFirstToken = false;
                                }
                                fullRawText += data.chunk;
                                textElem.innerHTML = renderFormattedResponse(fullRawText, currentMsgId);
                            }
                            if (data.citations) {
                                citations = data.citations;
                            }
                            if (data.disclaimer) {
                                disclaimerText = data.disclaimer;
                            }
                        } catch (e) { }
                    }
                }
                chatHistory.scrollTop = chatHistory.scrollHeight;
            }

            // Task 8: ChatGPT-style Grounded Policy Sources footer strip
            if (citations && citations.length > 0) {
                const sourcesStrip = document.createElement('div');
                sourcesStrip.className = 'copilot-sources-strip';
                let chipsHtml = citations.map((c, idx) => {
                    const docTitle = c.documentTitle || c.title || 'Policy';
                    const sec = c.section ? ` (Sec. ${escapeHtml(c.section)})` : '';
                    const ver = c.policyVersion ? ` <span style="font-size:0.68rem; color:#059669;">v${escapeHtml(c.policyVersion)}</span>` : '';
                    const excerpt = escapeHtml(c.excerpt || '');
                    return `
                        <div class="copilot-source-chip" id="source-${currentMsgId}-${idx + 1}" title="${excerpt}">
                            <span class="copilot-source-num">[${idx + 1}]</span>
                            <strong>${escapeHtml(docTitle)}</strong>${sec}${ver}
                        </div>
                    `;
                }).join('');

                sourcesStrip.innerHTML = `
                    <div class="copilot-sources-title">
                        📚 Grounded Policy Sources
                    </div>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.35rem;">
                        ${chipsHtml}
                    </div>
                `;
                bubbleElem.appendChild(sourcesStrip);
            }

            // Task 8: Regulatory Disclaimer Strip
            const disclaimerStrip = document.createElement('div');
            disclaimerStrip.className = 'copilot-disclaimer-strip';
            disclaimerStrip.innerHTML = `
                <span>⚖️</span>
                <div>
                    <strong>Regulatory Notice:</strong> ${escapeHtml(disclaimerText || 'Informational only. Explanations do not constitute a credit approval, rate lock, or binding commitment per TRID and Fair Lending regulations.')}
                </div>
            `;
            bubbleElem.appendChild(disclaimerStrip);
            chatHistory.scrollTop = chatHistory.scrollHeight;

        } catch (err) {
            if (shimmerElem) shimmerElem.style.display = 'none';
            if (textElem) {
                textElem.style.display = 'block';
                textElem.innerHTML = `<span style="color: #dc2626;">Error communicating with AI assistant: ${escapeHtml(err.message)}</span>`;
            }
        } finally {
            btn.disabled = false;
        }
    }

    function renderFormattedResponse(text, msgId) {
        let html = escapeHtml(text);

        // Convert bold **text**
        html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');

        // Convert newlines to breaks
        html = html.replace(/\n/g, '<br/>');

        // Convert in-prose numbered citations like [1], [2], [3] to clickable pills
        html = html.replace(/\[(\d+)\]/g, function(match, num) {
            return `<span class="copilot-cite-pill" title="Jump to source [${num}]" onclick="scrollToSource('${msgId}', '${num}')">[${num}]</span>`;
        });

        return html;
    }

    function scrollToSource(msgId, num) {
        const sourceEl = document.getElementById(`source-${msgId}-${num}`);
        if (sourceEl) {
            sourceEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            sourceEl.style.borderColor = '#2563eb';
            sourceEl.style.backgroundColor = '#eff6ff';
            setTimeout(() => {
                sourceEl.style.borderColor = '';
                sourceEl.style.backgroundColor = '';
            }, 1800);
        }
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.innerText = text;
        return div.innerHTML;
    }

    // Task 12: Auto-scroll to anchored document extraction toast if present
    document.addEventListener('DOMContentLoaded', function () {
        var toast = document.getElementById('docIntakeNotification');
        if (toast) {
            setTimeout(function () {
                toast.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }, 150);
        }
    });
</script>
