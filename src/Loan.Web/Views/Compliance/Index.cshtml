@model Loan.Web.Models.ComplianceDashboardViewModel
@{
    ViewData["Title"] = "Compliance & Audit Dashboard";
    ViewData["ActiveNav"] = "Compliance";
}

<div class="portal-container">
    <!-- Page Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
        <div>
            <span style="font-size: 0.75rem; font-weight: 700; color: #d97706; text-transform: uppercase; letter-spacing: 0.05em; background: #fffbeb; padding: 0.25rem 0.65rem; border-radius: 9999px;">
                Regulatory & Fair Lending Audit
            </span>
            <h1 style="font-size: 1.85rem; font-weight: 800; color: #0f172a; margin: 0.4rem 0 0.2rem 0;">Compliance Review Workspace</h1>
            <p style="font-size: 0.95rem; color: #64748b; margin: 0;">
                Auditing consumer disclosures, TRID/RESPA delivery windows, manual underwriting exceptions, and security guardrail events.
            </p>
        </div>
        <div>
            <span class="badge" style="background: #fef3c7; color: #92400e; border: 1px solid #fde68a; font-size: 0.85rem; font-weight: 700; padding: 0.45rem 0.85rem; border-radius: 8px;">
                🔒 Read-Only Enforcement Active
            </span>
        </div>
    </div>

    <!-- 4 Metric Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
        <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <span style="font-size: 0.78rem; font-weight: 600; color: #64748b; text-transform: uppercase;">Total Audited Files</span>
            <div style="font-size: 2rem; font-weight: 800; color: #0f172a; margin: 0.35rem 0;">@Model.TotalAuditedApplications</div>
            <span style="font-size: 0.75rem; color: #2563eb;">100% Covered Under BR-01</span>
        </div>

        <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <span style="font-size: 0.78rem; font-weight: 600; color: #d97706; text-transform: uppercase;">Flagged Policy Exceptions</span>
            <div style="font-size: 2rem; font-weight: 800; color: #d97706; margin: 0.35rem 0;">@Model.FlaggedExceptionsCount</div>
            <span style="font-size: 0.75rem; color: #64748b;">Requires Manual Officer Rationale</span>
        </div>

        <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <span style="font-size: 0.78rem; font-weight: 600; color: #059669; text-transform: uppercase;">TRID 3-Day Disclosures</span>
            <div style="font-size: 2rem; font-weight: 800; color: #059669; margin: 0.35rem 0;">100%</div>
            <span style="font-size: 0.75rem; color: #059669;">@Model.TridCompliantCount / @Model.TridCompliantCount Compliant</span>
        </div>

        <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <span style="font-size: 0.78rem; font-weight: 600; color: #dc2626; text-transform: uppercase;">Security Guardrail Events</span>
            <div style="font-size: 2rem; font-weight: 800; color: #dc2626; margin: 0.35rem 0;">@Model.SecurityEventsCount</div>
            <span style="font-size: 0.75rem; color: #64748b;">Intercepted Injections / RBAC Blocks</span>
        </div>
    </div>

    <!-- Grid: Compliance Queue & Grounded AI Assistant -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem;">
        <!-- Left: Compliance Review Queue -->
        <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <h2 style="font-size: 1.15rem; font-weight: 700; color: #1e293b; margin: 0;">📋 Application Compliance Queue</h2>
                <span class="badge badge-info">@Model.ComplianceQueue.Count Files</span>
            </div>

            <div style="overflow-x: auto;">
                <table class="table" style="width: 100%; border-collapse: collapse; font-size: 0.85rem;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0; text-align: left;">
                            <th style="padding: 0.6rem;">App ID</th>
                            <th style="padding: 0.6rem;">Borrower</th>
                            <th style="padding: 0.6rem;">Product</th>
                            <th style="padding: 0.6rem;">Exceptions</th>
                            <th style="padding: 0.6rem;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model.ComplianceQueue)
                        {
                            var hasExceptions = app.Indicators?.UnmetConditions.Any() == true || app.CurrentRecommendation?.PolicyViolations.Any() == true;
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 0.6rem;"><strong>@app.ApplicationId</strong></td>
                                <td style="padding: 0.6rem;">@app.Facts.FullName</td>
                                <td style="padding: 0.6rem;">@app.ProductRules.ProductName</td>
                                <td style="padding: 0.6rem;">
                                    @if (hasExceptions)
                                    {
                                        <span class="badge badge-warning" style="font-size: 0.72rem;">Exceptions Flagged</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success" style="font-size: 0.72rem;">Clean File</span>
                                    }
                                </td>
                                <td style="padding: 0.6rem;">
                                    <a href="/Compliance/Review/@app.ApplicationId" class="btn" style="background: #f8fafc; border: 1px solid #cbd5e1; padding: 0.25rem 0.6rem; border-radius: 4px; font-size: 0.75rem; text-decoration: none; color: #334155; font-weight: 600;">
                                        Inspect Audit &rarr;
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Right: Grounded Compliance AI Assistant (Task 8 Copilot Experience) -->
        <div class="copilot-chat-card" style="min-height: 440px;">
            <div class="copilot-chat-header">
                <div class="copilot-chat-header-title">
                    <span class="copilot-live-dot"></span>
                    <h2>⚖️ Compliance Policy AI Assistant</h2>
                </div>
                <span class="badge" style="background: #e0f2fe; color: #0369a1; font-size: 0.72rem; font-weight: 700;">
                    Azure AI Search Grounded
                </span>
            </div>

            <div id="compChatHistory" class="copilot-chat-history" style="max-height: 280px;">
                <div class="copilot-bubble-wrapper-assistant">
                    <span class="copilot-sender-label" style="color: #2563eb;">Compliance Copilot</span>
                    <div class="copilot-bubble-assistant">
                        Ask regulatory questions regarding federal compliance (e.g. TRID/RESPA timing, Fair Lending guidelines, adverse action notifications, or document retention rules).
                    </div>
                </div>
            </div>

            <!-- Quick Prompt Chips for Auditor -->
            <div class="copilot-prompt-chips">
                <button type="button" class="copilot-prompt-chip" onclick="quickCompAsk('What is the TRID Loan Estimate delivery deadline?')">TRID 3-Day Rule</button>
                <button type="button" class="copilot-prompt-chip" onclick="quickCompAsk('What are the mandatory Fair Lending adverse action notice requirements?')">Adverse Action Notice</button>
                <button type="button" class="copilot-prompt-chip" onclick="quickCompAsk('What are the record retention rules for denied applications?')">Record Retention</button>
                <button type="button" class="copilot-prompt-chip" onclick="quickCompAsk('What exceptions require secondary compliance officer sign-off?')">Sign-off Thresholds</button>
            </div>

            <div class="copilot-input-area">
                <input type="text" id="compQInput" class="copilot-input-field" placeholder="Ask compliance question..." onkeydown="if(event.key==='Enter'){event.preventDefault(); sendCompQuestion();}" />
                <button type="button" id="btnCompMic" class="copilot-mic-btn" onclick="toggleComplianceSpeech()" title="Start voice input" aria-label="Start voice input" aria-pressed="false">
                    <svg class="mic-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                        <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                        <line x1="12" y1="19" x2="12" y2="23"></line>
                        <line x1="8" y1="23" x2="16" y2="23"></line>
                    </svg>
                </button>
                <button type="button" id="btnCompSend" class="copilot-send-btn" onclick="sendCompQuestion()">
                    Query <span>&rarr;</span>
                </button>
            </div>
            <div id="compSpeechStatus" class="copilot-speech-status" style="display: none;"></div>
        </div>
    </div>

    <!-- Audit Timeline & Security Events Logs -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
        <!-- Audit Events -->
        <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <h3 style="font-size: 1rem; font-weight: 700; color: #1e293b; margin-bottom: 0.75rem;">📜 Real-Time Audit Log Activity</h3>
            <div style="max-height: 250px; overflow-y: auto;">
                <table class="table" style="width: 100%; border-collapse: collapse; font-size: 0.8rem;">
                    <thead>
                        <tr style="background: #f8fafc; text-align: left;">
                            <th style="padding: 0.5rem;">App ID</th>
                            <th style="padding: 0.5rem;">Action</th>
                            <th style="padding: 0.5rem;">Actor</th>
                            <th style="padding: 0.5rem;">Time (UTC)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var aud in Model.RecentAuditEvents)
                        {
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 0.5rem;"><code>@aud.ApplicationId</code></td>
                                <td style="padding: 0.5rem;"><span class="badge badge-info" style="font-size: 0.7rem;">@aud.Action</span></td>
                                <td style="padding: 0.5rem;">@aud.PerformedBy</td>
                                <td style="padding: 0.5rem;">@aud.TimestampUtc.ToString("HH:mm:ss")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Security Guardrail Events -->
        <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <h3 style="font-size: 1rem; font-weight: 700; color: #1e293b; margin-bottom: 0.75rem;">🛡️ Security & Intercept Events</h3>
            <div style="max-height: 250px; overflow-y: auto;">
                @foreach (var sec in Model.SecurityEvents)
                {
                    <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 0.75rem; margin-bottom: 0.75rem; font-size: 0.82rem;">
                        <div style="display: flex; justify-content: space-between; font-weight: 700; color: #991b1b; margin-bottom: 0.25rem;">
                            <span>@sec.EventType</span>
                            <span style="font-size: 0.75rem; font-weight: 400; color: #64748b;">@sec.TimestampUtc.ToString("g")</span>
                        </div>
                        <div style="color: #475569; margin-bottom: 0.25rem;"><strong>Snippet:</strong> <code>@sec.QuerySnippet</code></div>
                        <div style="color: #059669; font-weight: 600;">Action: @sec.InterceptReason</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function quickCompAsk(text) {
        const input = document.getElementById('compQInput');
        input.value = text;
        sendCompQuestion();
    }

    function toggleComplianceSpeech() {
        if (typeof window.toggleCopilotSpeech === 'function') {
            window.toggleCopilotSpeech('btnCompMic', 'compQInput', 'compSpeechStatus');
        } else if (typeof toggleCopilotSpeech === 'function') {
            toggleCopilotSpeech('btnCompMic', 'compQInput', 'compSpeechStatus');
        }
    }

    if (typeof window.toggleCopilotSpeech !== 'function') {
        (function () {
            var activeRec = null, activeBtn = null, activeIn = null, activeSt = null, baseTxt = '';
            window.toggleCopilotSpeech = function (btnId, inputId, statusId) {
                var btn = typeof btnId === 'string' ? document.getElementById(btnId) : btnId;
                var input = typeof inputId === 'string' ? document.getElementById(inputId) : inputId;
                var status = statusId ? (typeof statusId === 'string' ? document.getElementById(statusId) : statusId) : null;
                if (!btn || !input) return;

                if (activeRec && activeBtn === btn) { stop(); return; }
                if (activeRec) { stop(); }

                var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
                if (!SR) {
                    if (status) {
                        status.textContent = "Voice speech-to-text is not supported in this browser. Please use Chrome, Edge, or Safari, or type your question.";
                        status.className = 'copilot-speech-status error';
                        status.style.display = 'flex';
                        setTimeout(function () { if (status) status.style.display = 'none'; }, 6000);
                    }
                    return;
                }

                try {
                    var rec = new SR();
                    rec.continuous = true;
                    rec.interimResults = true;
                    rec.lang = 'en-US';
                    activeRec = rec; activeBtn = btn; activeIn = input; activeSt = status;
                    baseTxt = (input.value || '').trim() ? (input.value || '').trim() + ' ' : '';

                    rec.onstart = function () {
                        btn.classList.add('listening');
                        btn.setAttribute('aria-pressed', 'true');
                        if (status) {
                            status.textContent = "Listening... Speak your prompt. Click the microphone again when done.";
                            status.className = 'copilot-speech-status';
                            status.style.display = 'flex';
                        }
                    };

                    rec.onresult = function (ev) {
                        var interim = '', finalVal = '';
                        for (var i = 0; i < ev.results.length; ++i) {
                            if (ev.results[i].isFinal) finalVal += ev.results[i][0].transcript.trim() + ' ';
                            else interim += ev.results[i][0].transcript;
                        }
                        input.value = (baseTxt + finalVal + interim).trim();
                    };

                    rec.onerror = function (ev) {
                        var err = ev.error;
                        stop();
                        if (status && err !== 'aborted') {
                            var msg = err === 'not-allowed' || err === 'permission-denied'
                                ? "Microphone access was denied. Please allow microphone permissions in your browser address bar."
                                : err === 'no-speech' ? "No speech detected. Tap the microphone to speak again."
                                : err === 'network' ? "Speech service network error. Check your internet connection."
                                : "Voice input: " + err;
                            status.textContent = msg;
                            status.className = 'copilot-speech-status' + (err === 'no-speech' ? '' : ' error');
                            status.style.display = 'flex';
                            setTimeout(function () { if (status) status.style.display = 'none'; }, 6000);
                        }
                    };

                    rec.onend = function () { if (activeRec === rec) stop(); };
                    rec.start();
                } catch (e) {
                    stop();
                    if (status) {
                        status.textContent = "Unable to start speech recognition: " + (e.message || e);
                        status.className = 'copilot-speech-status error';
                        status.style.display = 'flex';
                        setTimeout(function () { if (status) status.style.display = 'none'; }, 6000);
                    }
                }
            };

            function stop() {
                if (activeRec) { try { activeRec.abort(); } catch (e) { } activeRec = null; }
                if (activeBtn) { activeBtn.classList.remove('listening'); activeBtn.setAttribute('aria-pressed', 'false'); activeBtn = null; }
                if (activeSt && !activeSt.classList.contains('error')) {
                    var s = activeSt;
                    setTimeout(function () { if (!activeRec && s) s.style.display = 'none'; }, 2000);
                }
                activeIn = null; activeSt = null;
            }
        })();
    }

    let compMsgCounter = 0;

    async function sendCompQuestion() {
        const input = document.getElementById('compQInput');
        const question = input.value.trim();
        if (!question) return;

        const chatHistory = document.getElementById('compChatHistory');
        const btnSend = document.getElementById('btnCompSend');
        const currentMsgId = ++compMsgCounter;

        // Append Auditor user bubble
        const userDiv = document.createElement('div');
        userDiv.className = 'copilot-bubble-wrapper-user';
        userDiv.innerHTML = `
            <span class="copilot-sender-label">Compliance Auditor</span>
            <div class="copilot-bubble-user" style="background: linear-gradient(135deg, #0f766e 0%, #0d9488 100%); max-width: 85%;">
                ${escapeCompHtml(question)}
            </div>
        `;
        chatHistory.appendChild(userDiv);
        input.value = '';
        btnSend.disabled = true;

        // Create Assistant bubble with typing shimmer
        const assistantWrapper = document.createElement('div');
        assistantWrapper.className = 'copilot-bubble-wrapper-assistant';
        assistantWrapper.innerHTML = `
            <span class="copilot-sender-label" style="color: #0d9488;">Compliance Copilot</span>
            <div class="copilot-bubble-assistant" id="comp-bubble-${currentMsgId}" style="max-width: 95%;">
                <div class="copilot-typing-shimmer" id="comp-shimmer-${currentMsgId}">
                    <span class="copilot-typing-dot"></span>
                    <span class="copilot-typing-dot"></span>
                    <span class="copilot-typing-dot"></span>
                    <span>Querying regulatory policy index...</span>
                </div>
                <div class="copilot-content-text" id="comp-text-${currentMsgId}" style="display: none;"></div>
            </div>
        `;
        chatHistory.appendChild(assistantWrapper);
        chatHistory.scrollTop = chatHistory.scrollHeight;

        const bubbleElem = document.getElementById(`comp-bubble-${currentMsgId}`);
        const shimmerElem = document.getElementById(`comp-shimmer-${currentMsgId}`);
        const textElem = document.getElementById(`comp-text-${currentMsgId}`);

        let fullRawText = '';
        let citations = [];
        let disclaimerText = '';
        let isFirstToken = true;

        try {
            const encodedQ = encodeURIComponent(question);
            const response = await fetch(`/Compliance/ComplianceChatStream?question=${encodedQ}`);
            const reader = response.body.getReader();
            const decoder = new TextDecoder();
            let buffer = '';

            while (true) {
                const { done, value } = await reader.read();
                if (done) break;

                buffer += decoder.decode(value, { stream: true });
                const lines = buffer.split('\n');
                buffer = lines.pop();

                for (const line of lines) {
                    if (line.startsWith('data: ')) {
                        const dataStr = line.replace('data: ', '').trim();
                        if (dataStr === '[DONE]') break;

                        try {
                            const parsed = JSON.parse(dataStr);
                            if (parsed.chunk) {
                                if (isFirstToken) {
                                    if (shimmerElem) shimmerElem.style.display = 'none';
                                    if (textElem) textElem.style.display = 'block';
                                    isFirstToken = false;
                                }
                                fullRawText += parsed.chunk;
                                textElem.innerHTML = renderCompFormatted(fullRawText, currentMsgId);
                                chatHistory.scrollTop = chatHistory.scrollHeight;
                            }
                            if (parsed.citations) {
                                citations = parsed.citations;
                            }
                            if (parsed.disclaimer) {
                                disclaimerText = parsed.disclaimer;
                            }
                        } catch (e) {}
                    }
                }
            }

            // Grounded Policy Sources footer strip
            if (citations && citations.length > 0) {
                const sourcesStrip = document.createElement('div');
                sourcesStrip.className = 'copilot-sources-strip';
                let chipsHtml = citations.map((c, idx) => {
                    const docTitle = c.documentTitle || c.title || 'Policy';
                    const sec = c.section ? ` (Sec. ${escapeCompHtml(c.section)})` : '';
                    const ver = c.policyVersion ? ` <span style="font-size:0.68rem; color:#059669;">v${escapeCompHtml(c.policyVersion)}</span>` : '';
                    const excerpt = escapeCompHtml(c.excerpt || '');
                    return `
                        <div class="copilot-source-chip" id="comp-source-${currentMsgId}-${idx + 1}" title="${excerpt}">
                            <span class="copilot-source-num">[${idx + 1}]</span>
                            <strong>${escapeCompHtml(docTitle)}</strong>${sec}${ver}
                        </div>
                    `;
                }).join('');

                sourcesStrip.innerHTML = `
                    <div class="copilot-sources-title">
                        📚 Grounded Policy Sources
                    </div>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.35rem;">
                        ${chipsHtml}
                    </div>
                `;
                bubbleElem.appendChild(sourcesStrip);
            }

            // Regulatory Disclaimer Strip
            const disclaimerStrip = document.createElement('div');
            disclaimerStrip.className = 'copilot-disclaimer-strip';
            disclaimerStrip.innerHTML = `
                <span>⚖️</span>
                <div>
                    <strong>Regulatory Advisory:</strong> ${escapeCompHtml(disclaimerText || 'Compliance guidance is grounded in active consumer protection & fair lending guides.')}
                </div>
            `;
            bubbleElem.appendChild(disclaimerStrip);
            chatHistory.scrollTop = chatHistory.scrollHeight;

        } catch (err) {
            if (shimmerElem) shimmerElem.style.display = 'none';
            if (textElem) {
                textElem.style.display = 'block';
                textElem.innerHTML = `<span style="color: #dc2626;">Error communicating with AI assistant: ${escapeCompHtml(err.message)}</span>`;
            }
        } finally {
            btnSend.disabled = false;
        }
    }

    function renderCompFormatted(text, msgId) {
        let html = escapeCompHtml(text);
        html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        html = html.replace(/\n/g, '<br/>');
        html = html.replace(/\[(\d+)\]/g, function(match, num) {
            return `<span class="copilot-cite-pill" title="Jump to source [${num}]" onclick="scrollToCompSource('${msgId}', '${num}')">[${num}]</span>`;
        });
        return html;
    }

    function scrollToCompSource(msgId, num) {
        const sourceEl = document.getElementById(`comp-source-${msgId}-${num}`);
        if (sourceEl) {
            sourceEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            sourceEl.style.borderColor = '#0d9488';
            sourceEl.style.backgroundColor = '#f0fdfa';
            setTimeout(() => {
                sourceEl.style.borderColor = '';
                sourceEl.style.backgroundColor = '';
            }, 1800);
        }
    }

    function escapeCompHtml(text) {
        const div = document.createElement('div');
        div.innerText = text;
        return div.innerHTML;
    }
</script>
}
