@model Loan.Web.Models.ComplianceDashboardViewModel
@{
    ViewData["Title"] = "Compliance & Audit Dashboard";
    ViewData["ActiveNav"] = "Compliance";
}

<div style="max-width: 1200px; margin: 0 auto; padding: 1.5rem 1rem;">
    <!-- Page Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
        <div>
            <span style="font-size: 0.75rem; font-weight: 700; color: #d97706; text-transform: uppercase; letter-spacing: 0.05em; background: #fffbeb; padding: 0.25rem 0.65rem; border-radius: 9999px;">
                Regulatory & Fair Lending Audit
            </span>
            <h1 style="font-size: 1.85rem; font-weight: 800; color: #0f172a; margin: 0.4rem 0 0.2rem 0;">Compliance Review Workspace</h1>
            <p style="font-size: 0.95rem; color: #64748b; margin: 0;">
                Auditing consumer disclosures, TRID/RESPA delivery windows, manual underwriting exceptions, and security guardrail events.
            </p>
        </div>
        <div>
            <span class="badge" style="background: #fef3c7; color: #92400e; border: 1px solid #fde68a; font-size: 0.85rem; font-weight: 700; padding: 0.45rem 0.85rem; border-radius: 8px;">
                🔒 Read-Only Enforcement Active
            </span>
        </div>
    </div>

    <!-- 4 Metric Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
        <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <span style="font-size: 0.78rem; font-weight: 600; color: #64748b; text-transform: uppercase;">Total Audited Files</span>
            <div style="font-size: 2rem; font-weight: 800; color: #0f172a; margin: 0.35rem 0;">@Model.TotalAuditedApplications</div>
            <span style="font-size: 0.75rem; color: #2563eb;">100% Covered Under BR-01</span>
        </div>

        <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <span style="font-size: 0.78rem; font-weight: 600; color: #d97706; text-transform: uppercase;">Flagged Policy Exceptions</span>
            <div style="font-size: 2rem; font-weight: 800; color: #d97706; margin: 0.35rem 0;">@Model.FlaggedExceptionsCount</div>
            <span style="font-size: 0.75rem; color: #64748b;">Requires Manual Officer Rationale</span>
        </div>

        <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <span style="font-size: 0.78rem; font-weight: 600; color: #059669; text-transform: uppercase;">TRID 3-Day Disclosures</span>
            <div style="font-size: 2rem; font-weight: 800; color: #059669; margin: 0.35rem 0;">100%</div>
            <span style="font-size: 0.75rem; color: #059669;">@Model.TridCompliantCount / @Model.TridCompliantCount Compliant</span>
        </div>

        <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <span style="font-size: 0.78rem; font-weight: 600; color: #dc2626; text-transform: uppercase;">Security Guardrail Events</span>
            <div style="font-size: 2rem; font-weight: 800; color: #dc2626; margin: 0.35rem 0;">@Model.SecurityEventsCount</div>
            <span style="font-size: 0.75rem; color: #64748b;">Intercepted Injections / RBAC Blocks</span>
        </div>
    </div>

    <!-- Grid: Compliance Queue & Grounded AI Assistant -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem;">
        <!-- Left: Compliance Review Queue -->
        <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <h2 style="font-size: 1.15rem; font-weight: 700; color: #1e293b; margin: 0;">📋 Application Compliance Queue</h2>
                <span class="badge badge-info">@Model.ComplianceQueue.Count Files</span>
            </div>

            <div style="overflow-x: auto;">
                <table class="table" style="width: 100%; border-collapse: collapse; font-size: 0.85rem;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0; text-align: left;">
                            <th style="padding: 0.6rem;">App ID</th>
                            <th style="padding: 0.6rem;">Borrower</th>
                            <th style="padding: 0.6rem;">Product</th>
                            <th style="padding: 0.6rem;">Exceptions</th>
                            <th style="padding: 0.6rem;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model.ComplianceQueue)
                        {
                            var hasExceptions = app.Indicators?.UnmetConditions.Any() == true || app.CurrentRecommendation?.PolicyViolations.Any() == true;
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 0.6rem;"><strong>@app.ApplicationId</strong></td>
                                <td style="padding: 0.6rem;">@app.Facts.FullName</td>
                                <td style="padding: 0.6rem;">@app.ProductRules.ProductName</td>
                                <td style="padding: 0.6rem;">
                                    @if (hasExceptions)
                                    {
                                        <span class="badge badge-warning" style="font-size: 0.72rem;">Exceptions Flagged</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success" style="font-size: 0.72rem;">Clean File</span>
                                    }
                                </td>
                                <td style="padding: 0.6rem;">
                                    <a href="/Compliance/Review/@app.ApplicationId" class="btn" style="background: #f8fafc; border: 1px solid #cbd5e1; padding: 0.25rem 0.6rem; border-radius: 4px; font-size: 0.75rem; text-decoration: none; color: #334155; font-weight: 600;">
                                        Inspect Audit &rarr;
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Right: Grounded Compliance AI Assistant -->
        <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); display: flex; flex-direction: column;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <div>
                    <h2 style="font-size: 1.15rem; font-weight: 700; color: #1e293b; margin: 0;">⚖️ Compliance Policy AI Assistant</h2>
                    <span style="font-size: 0.78rem; color: #64748b;">Grounded Regulatory Querying</span>
                </div>
                <span class="badge badge-success" style="font-size: 0.72rem;">Azure RAG Active</span>
            </div>

            <div id="compChatHistory" style="flex: 1; min-height: 180px; max-height: 240px; overflow-y: auto; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 0.75rem; margin-bottom: 0.75rem; font-size: 0.85rem;">
                <span style="color: #64748b;">Ask regulatory questions (e.g. "What is the TRID Loan Estimate delivery deadline?" or "What fair lending disclosures are required?"):</span>
            </div>

            <div style="display: flex; gap: 0.5rem;">
                <input type="text" id="compQInput" class="form-control" placeholder="Ask compliance question..." style="font-size: 0.85rem; padding: 0.5rem 0.75rem; flex: 1;" onkeydown="if(event.key==='Enter'){event.preventDefault(); sendCompQuestion();}" />
                <button type="button" id="btnCompSend" class="btn btn-primary" style="font-size: 0.85rem; padding: 0.5rem 1rem;" onclick="sendCompQuestion()">Ask</button>
            </div>
        </div>
    </div>

    <!-- Audit Timeline & Security Events Logs -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
        <!-- Audit Events -->
        <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <h3 style="font-size: 1rem; font-weight: 700; color: #1e293b; margin-bottom: 0.75rem;">📜 Real-Time Audit Log Activity</h3>
            <div style="max-height: 250px; overflow-y: auto;">
                <table class="table" style="width: 100%; border-collapse: collapse; font-size: 0.8rem;">
                    <thead>
                        <tr style="background: #f8fafc; text-align: left;">
                            <th style="padding: 0.5rem;">App ID</th>
                            <th style="padding: 0.5rem;">Action</th>
                            <th style="padding: 0.5rem;">Actor</th>
                            <th style="padding: 0.5rem;">Time (UTC)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var aud in Model.RecentAuditEvents)
                        {
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 0.5rem;"><code>@aud.ApplicationId</code></td>
                                <td style="padding: 0.5rem;"><span class="badge badge-info" style="font-size: 0.7rem;">@aud.Action</span></td>
                                <td style="padding: 0.5rem;">@aud.PerformedBy</td>
                                <td style="padding: 0.5rem;">@aud.TimestampUtc.ToString("HH:mm:ss")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Security Guardrail Events -->
        <div class="card" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <h3 style="font-size: 1rem; font-weight: 700; color: #1e293b; margin-bottom: 0.75rem;">🛡️ Security & Intercept Events</h3>
            <div style="max-height: 250px; overflow-y: auto;">
                @foreach (var sec in Model.SecurityEvents)
                {
                    <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 0.75rem; margin-bottom: 0.75rem; font-size: 0.82rem;">
                        <div style="display: flex; justify-content: space-between; font-weight: 700; color: #991b1b; margin-bottom: 0.25rem;">
                            <span>@sec.EventType</span>
                            <span style="font-size: 0.75rem; font-weight: 400; color: #64748b;">@sec.TimestampUtc.ToString("g")</span>
                        </div>
                        <div style="color: #475569; margin-bottom: 0.25rem;"><strong>Snippet:</strong> <code>@sec.QuerySnippet</code></div>
                        <div style="color: #059669; font-weight: 600;">Action: @sec.InterceptReason</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function sendCompQuestion() {
        const input = document.getElementById('compQInput');
        const question = input.value.trim();
        if (!question) return;

        const chatHistory = document.getElementById('compChatHistory');
        const btnSend = document.getElementById('btnCompSend');

        const userDiv = document.createElement('div');
        userDiv.style.margin = '0.5rem 0';
        userDiv.innerHTML = `<strong style="color:#0f172a;">Auditor:</strong> ${question}`;
        chatHistory.appendChild(userDiv);
        input.value = '';
        btnSend.disabled = true;

        const aiDiv = document.createElement('div');
        aiDiv.style.margin = '0.5rem 0';
        aiDiv.style.color = '#1e3a8a';
        const aiText = document.createElement('span');
        aiDiv.innerHTML = `<strong style="color:#2563eb;">AI Guide:</strong> `;
        aiDiv.appendChild(aiText);
        chatHistory.appendChild(aiDiv);
        chatHistory.scrollTop = chatHistory.scrollHeight;

        try {
            const encodedQ = encodeURIComponent(question);
            const response = await fetch(`/Compliance/ComplianceChatStream?question=${encodedQ}`);
            const reader = response.body.getReader();
            const decoder = new TextDecoder();
            let buffer = '';

            while (true) {
                const { done, value } = await reader.read();
                if (done) break;

                buffer += decoder.decode(value, { stream: true });
                const lines = buffer.split('\n');
                buffer = lines.pop();

                for (const line of lines) {
                    if (line.startsWith('data: ')) {
                        const dataStr = line.replace('data: ', '').trim();
                        if (dataStr === '[DONE]') break;

                        try {
                            const parsed = JSON.parse(dataStr);
                            if (parsed.chunk) {
                                aiText.innerText += parsed.chunk;
                                chatHistory.scrollTop = chatHistory.scrollHeight;
                            }
                            if (parsed.isFinal && parsed.citations && parsed.citations.length > 0) {
                                const citeEl = document.createElement('div');
                                citeEl.style.fontSize = '0.75rem';
                                citeEl.style.color = '#475569';
                                citeEl.style.marginTop = '0.5rem';
                                citeEl.style.paddingTop = '0.35rem';
                                citeEl.style.borderTop = '1px solid #f1f5f9';

                                let citeHtml = '<strong style="display: block; margin-bottom: 0.25rem; color: #1e3a8a;">📚 Grounded Policy Sources:</strong>';
                                parsed.citations.forEach((c, idx) => {
                                    citeHtml += `<span style="display: inline-block; background: #f8fafc; border: 1px solid #cbd5e1; padding: 0.15rem 0.45rem; border-radius: 4px; margin-right: 0.35rem; margin-bottom: 0.25rem;">[${idx + 1}] ${c.title || c.documentTitle || 'Policy'} (Sec. ${c.section || 'N/A'})</span>`;
                                });
                                citeEl.innerHTML = citeHtml;
                                aiDiv.appendChild(citeEl);
                            }
                        } catch (e) {}
                    }
                }
            }
        } catch (err) {
            aiText.innerText += ' [Network error]';
        } finally {
            btnSend.disabled = false;
        }
    }
</script>
}
